# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Optional but recommended: enables Gemini-powered analysis for every visitor.
# Without it, Lemspector falls back to built-in rule-based diagnostics.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: port for the server (default 3000)
PORT=3000

# Note: there is intentionally no Lemlist key here. Each visitor connects
# their own Lemlist API key in the app; it stays in their browser.
