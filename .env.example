# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Required for AI analysis. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: server-side Lemlist API key for live campaign sync.
# Users can also paste their own key in the app's Settings panel (stored in their browser only).
# Without any key, the app runs in demo mode with sample campaigns.
LEMLIST_API_KEY=

# Optional: port for the server (default 3000)
PORT=3000
